[Unit]
Description=vps-sentinel Telegram monitoring bot
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=sentinel
Group=adm
EnvironmentFile=/opt/vps-sentinel/.env
ExecStart=/usr/bin/python3 /opt/vps-sentinel/sentinel.py
Restart=always
RestartSec=10

# Hardening
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
ReadWritePaths=/var/lib/sentinel

[Install]
WantedBy=multi-user.target
