# vps-sentinel configuration — copy to .env, never commit the real one.
SENTINEL_BOT_TOKEN=123456789:replace-with-your-botfather-token
SENTINEL_CHAT_ID=123456789

# systemd units to watch (comma separated), e.g. nginx,docker,postgresql
SENTINEL_SERVICES=nginx

# Optional tuning (defaults shown)
#SENTINEL_DISK_PATHS=/
#SENTINEL_DISK_THRESHOLD=85
#SENTINEL_LOAD_FACTOR=2.0
#SENTINEL_FAILED_BURST=20
#SENTINEL_FAILED_WINDOW=300
#SENTINEL_CHECK_INTERVAL=30
#SENTINEL_HEARTBEAT_HOUR=9
#SENTINEL_AUTH_LOG=/var/log/auth.log
#SENTINEL_STATE_FILE=/var/lib/sentinel/state.json
